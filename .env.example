# OpenClaw 24/7 Pinterest Worker Configuration Template

# 1. Telegram Bot HITL Credentials
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your numeric chat ID from @userinfobot
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 2. Chrome CDP & Session Configuration
CDP_PORT=9222
CDP_HOST=127.0.0.1
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_USER_DATA_DIR=./chrome_user_data

# 3. OpenClaw Automation Settings
AUTO_POST_INTERVAL_MINUTES=180
AUTO_POST_ENABLED=true
